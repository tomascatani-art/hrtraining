# PostgreSQL (Neon, Supabase, RDS o local)
DATABASE_URL="postgresql://user:password@host:5432/hrtraining"
# Secreto para firmar sesiones (mínimo 32 caracteres). Generar con: openssl rand -hex 32
AUTH_SECRET=""
# Carpeta para archivos subidos (videos, documentos). En producción, reemplazar por almacenamiento S3/R2.
UPLOAD_DIR="./uploads"
# Zona horaria del servidor y de la interfaz
APP_TZ="America/Argentina/Buenos_Aires"
NEXT_PUBLIC_TZ="America/Argentina/Buenos_Aires"
# Crear datos de demostración al ejecutar el seed (true/false)
SEED_DEMO="true"
